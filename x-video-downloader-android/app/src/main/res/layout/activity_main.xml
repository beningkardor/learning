<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="粘贴链接，后台稳定下载视频"
            android:textColor="@color/muted" android:textSize="16sp" />
        <EditText android:id="@+id/linkInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:background="@drawable/bg_input" android:hint="粘贴视频链接"
            android:inputType="textUri" android:singleLine="true" android:textColor="@color/ink"
            android:textColorHint="@color/muted" android:minHeight="58dp" />
        <Button android:id="@+id/parseButton" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="14dp" android:background="@drawable/bg_button" android:text="解析并下载"
            android:textAllCaps="false" android:textColor="@color/ink" android:textSize="16sp" />
        <LinearLayout android:id="@+id/downloadCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:background="@drawable/bg_card" android:elevation="0dp"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:id="@+id/fileInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="尚未开始下载" android:textColor="@color/ink" android:textSize="15sp" />
            <com.example.xvideodownloader.FlowProgressView android:id="@+id/progress" android:layout_width="match_parent"
                android:layout_height="18dp" android:layout_marginTop="16dp" />
            <TextView android:id="@+id/progressText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="13sp" />
            <Button android:id="@+id/resumeButton" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="12dp" android:background="@drawable/bg_button" android:text="继续下载"
                android:textAllCaps="false" android:textColor="@color/ink" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="30dp" android:text="支持：公开 X/Twitter 视频、直链 MP4/WebM，以及网页中公开暴露的视频资源\n下载会在后台继续，并保留失败时已下载的部分\n请只下载你有权保存和使用的内容"
            android:textColor="@color/muted" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
